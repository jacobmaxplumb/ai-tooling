# Copy this file to `.env` and fill in your own keys.
# `.env` is gitignored — your keys will not be committed.

# ---- OpenAI ----
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# ---- LangSmith (observability / tracing) ----
# Get a key at https://smith.langchain.com (Settings -> API Keys)
LANGSMITH_API_KEY=lsv2_your-langsmith-key-here

# Turn tracing on/off. When true, LangChain calls are streamed to LangSmith.
LANGSMITH_TRACING=true

# The LangSmith project your traces land in. Create it in the UI or let it
# auto-create on first trace.
LANGSMITH_PROJECT=ai-tooling-class

# You normally do not need to change this.
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
